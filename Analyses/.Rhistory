vals_c <- get_diff_vals(conditor_spatrast)
lims_diff <- quantile(abs(c(vals_a, vals_c)), 0.98, na.rm = TRUE) |> as.numeric()
lims_diff <- max(lims_diff, 0.1)
# ---- main plot builder (optionally keep legend) ----
make_centroid_diff_plot <- function(spatrast, species_label, lims_diff, keep_legend = FALSE) {
# 1) Suitability-weighted centroids through time
centroids <- lapply(seq_len(nlyr(spatrast)), function(i) {
r      <- spatrast[[i]]
vals   <- terra::values(r)[, 1]
coords <- terra::crds(r, na.rm = FALSE)
valid  <- is.finite(vals) & vals > 0
if (!any(valid)) return(NULL)
w  <- vals[valid]
xy <- coords[valid, ]
data.frame(
time_bp   = terra::time(spatrast)[i],
longitude = weighted.mean(xy[, 1], w),
latitude  = weighted.mean(xy[, 2], w)
)
}) |> dplyr::bind_rows()
# 0 ka and 20 ka layers
r_times <- as.numeric(terra::time(spatrast))
idx_0   <- which.min(abs(r_times - 0))
idx_20  <- which.min(abs(r_times + 20000))
pt_0  <- centroids[which.min(abs(centroids$time_bp - 0)), , drop = FALSE]
pt_20 <- centroids[which.min(abs(centroids$time_bp + 20000)), , drop = FALSE]
# 2) Difference raster (0 ka − 20 ka)
r_diff <- spatrast[[idx_0]] - spatrast[[idx_20]]
names(r_diff) <- "diff"
outline_v <- terra::vect(australia_outline)
outline_v <- terra::project(outline_v, terra::crs(spatrast))
r_diff  <- terra::mask(r_diff, outline_v)
df_diff <- as.data.frame(r_diff, xy = TRUE, na.rm = FALSE)
# 3) Dated middens (±500 yr)
m_sf <- middens_sf |> dplyr::mutate(time_bp = as.numeric(time_bp))
m_0  <- m_sf |> dplyr::filter(abs(time_bp - 0) <= 500)     |> dplyr::mutate(when = "0 ka")
m_20 <- m_sf |> dplyr::filter(abs(time_bp + 20000) <= 500) |> dplyr::mutate(when = "20 ka")
m_plot <- dplyr::bind_rows(m_20, m_0) |>
dplyr::mutate(when = factor(when, levels = c("20 ka", "0 ka")))
coords <- sf::st_coordinates(m_plot)
m_plot_df <- m_plot |>
dplyr::mutate(longitude = coords[, 1], latitude = coords[, 2]) |>
sf::st_drop_geometry()
# ---- guides (normal legend; no tiny bars that squish) ----
diff_fill_scale <- scale_fill_gradient2(
name     = "Change in suitability since 20 ka",
low      = "#ff7800",
mid      = "white",
high     = "#6112c2",
midpoint = 0,
limits   = c(-lims_diff, lims_diff),
na.value = "transparent"
)
centroid_time_scale <- scale_color_viridis_c(
name   = "Centroid Years BP",
option = "H",
limits = c(-40000, 0),
breaks = c(-40000, -30000, -20000, -10000, 0),
labels = c("40 ka", "30 ka", "20 ka", "10 ka", "0")
)
centroid_shape_scale <- scale_shape_manual(
name   = "Centroid positions",
values = c("20 ka centroid" = 24, "Present centroid" = 21),
guide  = guide_legend(
override.aes = list(fill = c("white", "yellow"), colour = "black")
)
)
midden_fill_scale <- scale_fill_manual(
values = c("20 ka" = "#E65100", "0 ka" = "#7C4DFF"),
guide  = "none"  # show via shape legend (with filled points)
)
midden_shape_scale <- scale_shape_manual(
name   = "Dated middens",
values = c("20 ka" = 24, "0 ka" = 21),
guide  = guide_legend(
override.aes = list(fill = c("#E65100", "#7C4DFF"), colour = "black")
)
)
p <- ggplot() +
geom_raster(data = df_diff, aes(x = x, y = y, fill = diff)) +
diff_fill_scale +
geom_sf(data = australia_outline, fill = NA, colour = "grey20", linewidth = 0.4) +
coord_sf(xlim = c(110, 155), ylim = c(-45, -10), expand = FALSE) +
geom_path(data = centroids, aes(longitude, latitude),
colour = "black", linewidth = 0.7, alpha = 0.85) +
geom_point(data = centroids, aes(longitude, latitude, colour = time_bp), size = 2) +
geom_point(data = pt_20, aes(longitude, latitude, shape = "20 ka centroid"),
size = 3, fill = "white", colour = "black", stroke = 0.6) +
geom_point(data = pt_0, aes(longitude, latitude, shape = "Present centroid"),
size = 3, fill = "yellow", colour = "black", stroke = 0.6) +
centroid_time_scale +
centroid_shape_scale +
ggnewscale::new_scale_fill() +
ggnewscale::new_scale_color() +
ggnewscale::new_scale("shape") +
geom_point(
data = m_plot_df,
aes(x = longitude, y = latitude, fill = when, shape = when),
colour = "black", size = 2.7, stroke = 0.4
) +
midden_fill_scale +
midden_shape_scale +
labs(x = "Longitude", y = "Latitude") +
theme_map_clean +
theme(
plot.title = element_text(face = "italic", size = 13),
legend.box = "vertical",
legend.direction = "vertical",
legend.title = element_text(size = 9),
legend.text  = element_text(size = 8),
legend.key.height = unit(0.55, "lines"),
legend.key.width  = unit(1.0, "lines"),
legend.spacing.y  = unit(0.25, "lines")
) +
ggtitle(species_label)
if (!isTRUE(keep_legend)) {
p <- p + theme(legend.position = "none")
} else {
# build a nice legend we can extract cleanly
p <- p + theme(
legend.position = "bottom",
legend.justification = "left",
legend.background = element_rect(fill = "white", colour = NA)
) +
guides(
fill   = guide_colorbar(order = 1, title.position = "top"),
colour = guide_colorbar(order = 2, title.position = "top"),
shape  = guide_legend(order = 3, title.position = "top")
)
}
p
}
# ---- Build maps (NO legend) ----
p_apicalis <- make_centroid_diff_plot(apicalis_spatrast,  "Leporillus apicalis",  lims_diff, keep_legend = FALSE)
p_conditor <- make_centroid_diff_plot(conditor_spatrast,  "Leporillus conditor",  lims_diff, keep_legend = FALSE)
# ---- Build a legend object (from a copy with legend enabled) ----
p_leg_source <- make_centroid_diff_plot(conditor_spatrast, "Leporillus conditor", lims_diff, keep_legend = TRUE)
leg <- cowplot::get_legend(
p_leg_source +
theme(
legend.position = "bottom",
legend.box.margin = margin(0, 0, 0, 0),
legend.margin     = margin(2, 2, 2, 2)
)
)
# ---- Inset the legend into the conditor panel (npc coords in that panel) ----
# left/bottom/right/top are 0–1 within the panel
p_conditor_inset <- p_conditor +
patchwork::inset_element(
leg,
left = 0.08, bottom = 0.08, right = 0.52, top = 0.26,
align_to = "panel"
)
combined_centroid_diff <- p_apicalis / p_conditor_inset
# ---- Save (crisp) ----
out_file <- file.path(combined_outdir, "combined_range_shift_0_vs_20ka_with_middens9.png")
if (requireNamespace("ragg", quietly = TRUE)) {
ragg::agg_png(out_file, width = 7.5, height = 13, units = "in", res = 300, background = "white")
print(combined_centroid_diff)
dev.off()
} else {
ggsave(out_file, combined_centroid_diff, width = 7.5, height = 13, dpi = 300, bg = "white")
}
combined_centroid_diff
